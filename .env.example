# Copie para .env e ajuste. O .env nunca é commitado.
#
# As variáveis de registry e de tag são preenchidas automaticamente por:
#   bash scripts/resolve-image-tags.sh [profile] [região]

# ─── Imagens no ECR ───────────────────────────────────────────────────────────
# Registry da conta, no formato <account-id>.dkr.ecr.<região>.amazonaws.com
ECR_REGISTRY=

# Tags das imagens — o SHA completo do commit que as originou.
# Os repositórios ECR são IMMUTABLE, então não existe "latest".
AUTH_SERVICE_TAG=
FLAG_SERVICE_TAG=
TARGETING_SERVICE_TAG=
EVALUATION_SERVICE_TAG=
ANALYTICS_SERVICE_TAG=

# ─── evaluation-service ───────────────────────────────────────────────────────
# Chave de API de serviço — criar depois que a pilha subir:
#   curl -X POST http://localhost:8001/admin/keys \
#     -H "Authorization: Bearer admin-secreto-123" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"evaluation-service-key"}'
EVALUATION_SERVICE_API_KEY=tm_key_your_key_here

# ─── AWS (opcional) ───────────────────────────────────────────────────────────
# Deixe AWS_SQS_URL vazio para rodar sem eventos: o evaluation-service loga
# [SQS_DISABLED] e o analytics-service fica sem fila para consumir.
AWS_SQS_URL=
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Credenciais com permissão de sqs:ReceiveMessage, sqs:DeleteMessage e dynamodb:PutItem.
# Use aspas se a secret tiver caracteres especiais (ex.: +)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
